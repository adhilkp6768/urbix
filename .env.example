# Portable default. Docker Compose overrides this with PostgreSQL/PostGIS.
DATABASE_URL=sqlite:///./urbix.db

# Optional gate for POST routes. Leave empty for local development.
URBIX_API_KEY=

# OpenAI-compatible chat endpoint. Leave the key empty to use the deterministic planner.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Required only for the OpenAQ station connector.
OPENAQ_API_KEY=

# Optional US Census Bureau key. The connector also tries keyless access.
CENSUS_API_KEY=

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MLFLOW_TRACKING_URI=file:./mlruns
URBIX_ENV=development

# Cloud only. 0 keeps local and test processes from fetching sources on startup.
URBIX_REFRESH_HOURS=0
URBIX_BOOTSTRAP_ON_START=0
